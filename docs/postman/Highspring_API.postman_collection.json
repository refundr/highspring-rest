{
  "info": {
    "_postman_id": "a8f3c2b1-4d5e-6f70-8192-highspring0001",
    "name": "Highspring API",
    "description": "REST collection for the Highspring Jetty API (port 8090).\n\nAuth: set collection variable `sessionId`, then requests send `Authorization: session:{{sessionId}}`.\n\nSee docs/AUTH.md for how to obtain a session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8090" },
    { "key": "sessionId", "value": "" },
    { "key": "redirectUri", "value": "http://localhost:3000/auth/callback" },
    { "key": "productId", "value": "" },
    { "key": "purchaseId", "value": "" },
    { "key": "errorId", "value": "" }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Google auth URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  console.log('Open this URL in a browser:', j.uri);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"redirectUri\": \"{{redirectUri}}\",\n  \"state\": \"highspring\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/google/url/",
            "description": "No session required. Returns `{ \"uri\": \"https://accounts.google.com/...\" }`. Open `uri` in a browser, sign in, then copy the `code` query param from the redirect to `{{redirectUri}}`."
          }
        },
        {
          "name": "Exchange Google code for session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('sessionId', j.sessionId);",
                  "  console.log('sessionId saved:', j.sessionId, 'role:', j.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"PASTE_GOOGLE_CODE_HERE\",\n  \"redirectUri\": \"{{redirectUri}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/google/callback/",
            "description": "Paste the one-time `code` from Google’s redirect. On success, Tests tab saves `sessionId` into the collection variable."
          }
        },
        {
          "name": "Logout (revoke session)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/auth/logout/",
            "description": "Deletes the `api_session` row. Expect 204. Clear `sessionId` afterward."
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/me/",
            "description": "Current user: sessionId, userId, email, displayName, role."
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const items = pm.response.json();",
                  "  if (Array.isArray(items) && items.length > 0) {",
                  "    pm.collectionVariables.set('productId', items[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/products/",
            "description": "Seeded catalog. Tests tab stores the first product id in `productId`."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/cart/",
            "description": "Server-persisted cart for the signed-in user."
          }
        },
        {
          "name": "Add cart item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/v1/cart/items/",
            "description": "Increments quantity for a product (creates the line if missing)."
          }
        },
        {
          "name": "Set cart item quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/v1/cart/items/",
            "description": "Absolute quantity. Use `0` to remove the line."
          }
        },
        {
          "name": "Checkout cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('purchaseId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/v1/cart/checkout/",
            "description": "Creates a purchase from the cart and empties the cart (demo: no payment provider). Expect 201."
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/cart/",
            "description": "Removes all cart lines. Expect 204."
          }
        }
      ]
    },
    {
      "name": "Purchases",
      "item": [
        {
          "name": "Create purchase (items body)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('purchaseId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/purchases/",
            "description": "Alternate checkout that takes an items array (does not use the saved cart)."
          }
        },
        {
          "name": "Get purchase by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/purchases/{{purchaseId}}/",
            "description": "Owner or ADMIN only."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires `role: ADMIN` (email listed in API `ADMIN_EMAILS`).",
      "item": [
        {
          "name": "Totals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/totals/"
          }
        },
        {
          "name": "List purchases",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/purchases/"
          }
        },
        {
          "name": "List error logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const rows = pm.response.json();",
                  "  if (Array.isArray(rows) && rows.length > 0) {",
                  "    pm.collectionVariables.set('errorId', String(rows[0].id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/errors/"
          }
        },
        {
          "name": "Delete one error log",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/errors/{{errorId}}/"
          }
        },
        {
          "name": "Delete all error logs",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/errors/"
          }
        },
        {
          "name": "Demo boom (500)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/boom/",
            "description": "Requires `ENABLE_BOOM_ENDPOINT=true`. Expect 500; row appears in error logs."
          }
        },
        {
          "name": "Allure index",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/allure/index.html",
            "description": "HTML report after `mvn javadoc`/`allure:report` publish. Prefer the Remix Admin UI proxy for browsing."
          }
        },
        {
          "name": "Javadoc index",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "session:{{sessionId}}" }
            ],
            "url": "{{baseUrl}}/v1/admin/javadoc/index.html",
            "description": "Published after `mvn javadoc:aggregate`."
          }
        }
      ]
    }
  ]
}
