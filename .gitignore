# Maven
target/
**/target/

# Local secrets / overrides — intentionally tracked for interview demo convenience.
# Prefer env-var overrides in real deployments; rotate Google/SMTP secrets if this repo is public.
# application.template.properties remains the blank starter copy.

# IDE — ignore local IntelliJ state; keep portable JDK / import hints under .idea/
.idea/*
!.idea/
!.idea/.gitignore
!.idea/misc.xml
!.idea/compiler.xml
!.idea/vcs.xml
!.idea/encodings.xml
!.idea/jarRepositories.xml
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
.DS_Store

# Allure results / local Allure CLI cache (generated HTML under api/published-* is committed for Render)
.allure/
**/.allure/
allure-results/
**/allure-results/

# Logs
*.log
logs/

# Runtime
*.pid
*.class
